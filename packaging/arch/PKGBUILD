# Maintainer: zerosensee
# Независимый форк K-Tools (https://github.com/krnzhnr/k-tools) для Linux, C# / .NET + GTK4/libadwaita.
# Сборка из локальной копии репозитория (сеть не нужна — пакеты NuGet не используются):
#   cd packaging/arch && makepkg -si
pkgname=hktools
pkgver=2.0.0alpha1
pkgrel=1
pkgdesc="Пакетная обработка медиа на C#/.NET: кодирование (NVENC/VAAPI/x265), ремукс MKV, субтитры, Whisper, yt-dlp — GTK4/libadwaita"
arch=('any')
url="https://github.com/zerosensee/h-ktools-linux"
license=('MIT')
depends=(
  'dotnet-runtime>=8.0'
  'gtk4'
  'libadwaita'
  'ffmpeg'
)
makedepends=('dotnet-sdk-8.0' 'make')
optdepends=(
  'mkvtoolnix-cli: сборка MKV, сдвиг и пересадка аудио без перекодирования'
  'yt-dlp: загрузка медиа по ссылке'
  'deno: JS-рантайм для yt-dlp (YouTube)'
  'fdkaac: кодирование FDK-AAC / HE-AAC'
  'whisper.cpp: распознавание речи (AUR; варианты -cuda, -vulkan, -hip)'
  'libnotify: уведомления о завершении (notify-send)'
  'wine: запуск qaac64.exe (Apple AAC)'
  'libva-utils: диагностика VAAPI (vainfo)'
  'xdg-desktop-portal-gtk: диалоги выбора файлов в Hyprland'
)
options=('!strip' '!debug')
source=()
sha256sums=()

_srcroot() {
  # каталог репозитория относительно packaging/arch
  realpath "${startdir}/../.."
}

build() {
  cd "$(_srcroot)"
  export DOTNET_CLI_HOME="${srcdir}/dotnet-home" NUGET_PACKAGES="${srcdir}/nuget"
  make build
}

check() {
  cd "$(_srcroot)"
  export DOTNET_CLI_HOME="${srcdir}/dotnet-home" NUGET_PACKAGES="${srcdir}/nuget" XDG_CONFIG_HOME="${srcdir}/cfg"
  make test
}

package() {
  cd "$(_srcroot)"
  make install DESTDIR="${pkgdir}" PREFIX=/usr
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE.md "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE.md"
  install -Dm644 CHANGELOG.md "${pkgdir}/usr/share/doc/${pkgname}/CHANGELOG.md"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
